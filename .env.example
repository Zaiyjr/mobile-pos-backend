# Supabase PostgreSQL — Direct connection (5432)
# Get your password from: Supabase Dashboard > Project Settings > Database > Database password
# Project ref: nmhopxhlwpbcjzhzrvxj
DATABASE_URL="postgresql://postgres:[YOUR_SUPABASE_DB_PASSWORD]@db.nmhopxhlwpbcjzhzrvxj.supabase.co:5432/postgres"

# For Vercel / serverless with pooled connection (recommended for production):
# DATABASE_URL="postgresql://postgres.nmhopxhlwpbcjzhzrvxj:[YOUR_SUPABASE_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR_SUPABASE_DB_PASSWORD]@db.nmhopxhlwpbcjzhzrvxj.supabase.co:5432/postgres"

# Supabase API keys — Dashboard > Project Settings > API
SUPABASE_URL="https://nmhopxhlwpbcjzhzrvxj.supabase.co"
SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SUPABASE_SERVICE_ROLE_KEY]"

PORT=5000

# JWT signing secret — REQUIRED. The server now fails fast (throws) if this is
# empty. Use a long random value, e.g.:  openssl rand -hex 64
JWT_SECRET=change_me_to_a_random_secret

# Comma-separated CORS allow-list. Optional — when unset, defaults to the known
# frontends (localhost:5173 + the Vercel preview URLs).
# CORS_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"

# Verify the DB TLS certificate in production (secure default: true).
# Set to false only as a documented escape-hatch for poolers with unverifiable certs.
# PG_REJECT_UNAUTHORIZED=false
